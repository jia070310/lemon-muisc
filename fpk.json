{
  "name": "lemon-music",
  "title": "柠檬音乐下载",
  "displayName": "柠檬音乐下载",
  "appTitle": "Lemon Music",
  "description": "音乐搜索、试听、下载与标签管理。安装向导中填写各自的音乐库与下载目录。",
  "version": "1.0.3",
  "author": "jia070310",
  "icon": "icon.png",
  "type": "docker",
  "microApp": true,
  "apiScope": ["trim.file.userAccess"],
  "docker": {
    "image": "lemon-music:latest",
    "ports": [
      { "container": 7983, "host": 7983, "protocol": "tcp", "description": "Web UI" }
    ],
    "volumes": [
      { "container": "/music", "host": "/vol1/music", "description": "音乐库目录（扫描/管理）" },
      { "container": "/downloads", "host": "/vol1/music-downloads", "description": "下载保存目录" },
      { "container": "/config", "host": "/vol1/.apps/lemon-music/config", "description": "配置目录" }
    ],
    "environment": [
      { "key": "PORT", "value": "7983" },
      { "key": "DOWNLOAD_PATH", "value": "/music" },
      { "key": "CONFIG_PATH", "value": "/config" }
    ],
    "webUI": {
      "port": 7983,
      "path": "/"
    },
    "restart": "unless-stopped"
  }
}

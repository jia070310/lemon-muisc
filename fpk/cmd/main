#!/bin/bash

. "$(dirname "$0")/paths.sh"

is_docker_running() {
  docker_cmd inspect -f '{{.State.Running}}' "${CONTAINER_NAME}" 2>/dev/null | grep -qi true
}

# 开机后 Docker 可能尚未就绪；status/start 前短暂重试
ensure_docker_ready() {
  local i=0
  while [ "${i}" -lt 12 ]; do
    if init_docker_access 2>/dev/null; then
      return 0
    fi
    sleep 1
    i=$((i + 1))
  done
  init_docker_access 2>/dev/null
}

case $1 in
start)
  save_accessible_paths

  # 飞牛「启用」前若 Docker 异常会弹「docker不可用」；此处再检一次并给出可操作提示
  if ! ensure_docker_ready; then
    echo "Docker 当前不可用。请到飞牛「Docker」确认服务已启动，或 SSH 执行: systemctl restart docker ；然后重试启用。镜像已在本地时可: docker start lemon-music 或按 paths.conf 路径 docker run。" > "${TRIM_TEMP_LOGFILE}"
    exit 1
  fi

  # 优先：运行设置 / 访问权限；不要沿用飞牛 docker-project 冻住的 @appdata
  if apply_saved_paths; then
    :
  elif resolve_paths; then
    config="$(resolve_config_path)"
    write_compose_file "${RESOLVED_MUSIC}" "${RESOLVED_DOWNLOADS}" "${config}"
    write_mounts_meta "${RESOLVED_MUSIC}" "${RESOLVED_DOWNLOADS}" "${config}"
  elif [ -f "${COMPOSE_ENV}" ]; then
    # shellcheck disable=SC1090
    . "${COMPOSE_ENV}"
    write_compose_file "${wizard_music_path}" "${wizard_downloads_path}" "${wizard_config_path:-$(default_config_path)}"
  else
    load_paths
    if paths_ready; then
      config="$(resolve_config_path)"
      write_compose_file "${wizard_music_path}" "${wizard_downloads_path}" "${config}"
    else
      music="$(default_music_path)"
      downloads="$(default_downloads_path)"
      config="$(default_config_path)"
      save_paths "${music}" "${downloads}" "${config}"
      write_compose_file "${music}" "${downloads}" "${config}"
    fi
  fi

  # 启用：有本地镜像则直接用；没有则在线拉取
  if resolve_local_image_name "$(get_compose_image)" >/dev/null 2>&1 \
    || prefer_local_image_alias >/dev/null 2>&1; then
    export SKIP_REMOTE_PULL=1
  else
    unset SKIP_REMOTE_PULL
    export IMAGE_PULL_TIMEOUT="${wizard_pull_timeout:-600}"
  fi

  # 安装阶段已拉起 / 开机自启后已在跑：直接视为启用成功（同步应用中心「打开」状态）
  if is_container_running; then
    ensure_mounts_applied || true
    if is_container_running; then
      exit 0
    fi
  fi

  if ! recreate_compose_stack; then
    tip="容器启动失败。"
    if ! docker_cmd info >/dev/null 2>&1; then
      tip="Docker 不可用。请先在飞牛 Docker 中确认服务正常，或 SSH: systemctl restart docker 后重试启用。"
    elif ! docker_cmd image inspect "${LOCAL_IMAGE_ALIAS}" >/dev/null 2>&1 \
      && ! docker_cmd images --format '{{.Repository}}:{{.Tag}}' 2>/dev/null | grep -qE 'lemon-muisc|lemon-music'; then
      tip="${tip} 本地无 Docker 镜像，请重新安装应用（安装时会拉取），或 SSH: docker pull ghcr.1ms.run/jia070310/lemon-muisc:latest && docker tag ghcr.1ms.run/jia070310/lemon-muisc:latest lemon-music:latest"
    else
      tip="${tip} 请检查 7983 端口是否占用，或查看日志 ${TRIM_PKGVAR}/log/compose.recreate.log"
      tip="${tip} | $(tail -n 3 "${TRIM_PKGVAR}/log/compose.recreate.log" 2>/dev/null | tr '\n' ' ')"
    fi
    echo "${tip}" > "${TRIM_TEMP_LOGFILE}"
    exit 1
  fi
  exit 0
  ;;
stop)
  init_docker_access 2>/dev/null || true
  docker_cmd stop "${CONTAINER_NAME}" >/dev/null 2>&1 || true
  docker_cmd rm -f "${CONTAINER_NAME}" >/dev/null 2>&1 || true
  exit 0
  ;;
status)
  # 必须先 init_docker_access：否则无 sudo 时 inspect 失败，应用中心误显示「启用」
  if ! ensure_docker_ready; then
    exit 3
  fi
  if ! is_docker_running; then
    exit 3
  fi
  # 运行中但挂载被改回 @appdata 时，尝试纠偏（不拖垮 status）
  if resolve_paths; then
    case "${RESOLVED_MUSIC}" in
      "${TRIM_PKGVAR}"/*) ;;
      *)
        if ! mount_matches_expected "${RESOLVED_MUSIC}" "${RESOLVED_DOWNLOADS}"; then
          log_config "status: mounts stale, fixing..."
          ensure_mounts_applied || true
        fi
        ;;
    esac
  fi
  if is_docker_running; then
    exit 0
  fi
  exit 3
  ;;
*)
  exit 1
  ;;
esac

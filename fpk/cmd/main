#!/bin/bash

. "$(dirname "$0")/paths.sh"

is_docker_running() {
  docker inspect -f '{{.State.Running}}' "${CONTAINER_NAME}" 2>/dev/null | grep -qi true
}

case $1 in
start)
  if resolve_paths; then
    config="$(resolve_config_path)"
    write_compose_file "${RESOLVED_MUSIC}" "${RESOLVED_DOWNLOADS}" "${config}"
    write_mounts_meta "${RESOLVED_MUSIC}" "${RESOLVED_DOWNLOADS}" "${config}"
  elif [ -f "${COMPOSE_ENV}" ]; then
    # shellcheck disable=SC1090
    . "${COMPOSE_ENV}"
    write_compose_file "${wizard_music_path}" "${wizard_downloads_path}" "${wizard_config_path}"
  else
    echo "请先完成安装向导中的数据目录选择，或在应用设置中配置路径。" > "${TRIM_TEMP_LOGFILE}"
    exit 1
  fi

  if ! recreate_compose_stack; then
    echo "容器启动失败（常见原因：镜像未拉取成功）。请查看 ${TRIM_PKGVAR}/log/compose.recreate.log，或 SSH 执行: docker pull ghcr.1ms.run/jia070310/lemon-muisc:latest" > "${TRIM_TEMP_LOGFILE}"
    exit 1
  fi
  exit 0
  ;;
stop)
  docker stop "${CONTAINER_NAME}" >/dev/null 2>&1 || true
  docker rm -f "${CONTAINER_NAME}" >/dev/null 2>&1 || true
  exit 0
  ;;
status)
  if is_docker_running; then
    # 挂载被飞牛旧项目改回 @appdata 时，下次 start 会纠偏；status 仍报运行中
    exit 0
  fi
  exit 3
  ;;
*)
  exit 1
  ;;
esac

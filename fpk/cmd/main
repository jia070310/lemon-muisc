#!/bin/bash

. "$(dirname "$0")/paths.sh"

is_docker_running() {
  local running
  running=$(docker compose -p "${TRIM_APPNAME}" -f "${COMPOSE_FILE}" ps --format '{{.State}}' 2>/dev/null | grep -ci 'running')
  [ "${running:-0}" -gt 0 ]
}

ensure_containers_created() {
  cd "${COMPOSE_DIR}" || return 1

  local exists
  exists=$(docker compose -p "${TRIM_APPNAME}" -f "${COMPOSE_FILE}" ps -a --format '{{.Name}}' 2>/dev/null | wc -l)
  if [ "${exists:-0}" -gt 0 ]; then
    return 0
  fi

  docker compose -p "${TRIM_APPNAME}" -f "${COMPOSE_FILE}" up -d 2>&1
  if [ $? -ne 0 ]; then
    echo "Docker compose 创建容器失败。请检查 7983 端口、容器名是否冲突。" > "${TRIM_TEMP_LOGFILE}"
    return 1
  fi
  return 0
}

case $1 in
start)
  exit 0
  ;;
stop)
  exit 0
  ;;
status)
  if ! ensure_containers_created; then
    exit 1
  fi
  if is_docker_running; then
    exit 0
  fi
  exit 3
  ;;
*)
  exit 1
  ;;
esac

#!/bin/bash

. "$(dirname "$0")/paths.sh"

is_docker_running() {
  docker inspect -f '{{.State.Running}}' "${CONTAINER_NAME}" 2>/dev/null | grep -qi true
}

case $1 in
start)
  # 应用启动时：按已保存路径重写 compose 并拉起容器（覆盖飞牛安装时冻住的 @appdata 挂载）
  if resolve_paths; then
    config="$(resolve_config_path)"
    write_compose_file "${RESOLVED_MUSIC}" "${RESOLVED_DOWNLOADS}" "${config}"
    write_mounts_meta "${RESOLVED_MUSIC}" "${RESOLVED_DOWNLOADS}" "${config}"
  elif [ -f "${COMPOSE_ENV}" ]; then
    # shellcheck disable=SC1090
    . "${COMPOSE_ENV}"
    write_compose_file "${wizard_music_path}" "${wizard_downloads_path}" "${wizard_config_path}"
  else
    write_compose_file "$(default_music_path)" "$(default_downloads_path)" "$(default_config_path)"
  fi

  if ! recreate_compose_stack; then
    echo "Docker 容器启动失败。请到 Docker → lemon-music → 存储位置，把 /music、/downloads 改成你的 NAS 路径后重建。" > "${TRIM_TEMP_LOGFILE}"
    exit 1
  fi
  exit 0
  ;;
stop)
  docker stop "${CONTAINER_NAME}" >/dev/null 2>&1 || true
  docker compose -p "${COMPOSE_PROJECT}" -f "${COMPOSE_FILE}" down >/dev/null 2>&1 || true
  exit 0
  ;;
status)
  if is_docker_running; then
    exit 0
  fi
  exit 3
  ;;
*)
  exit 1
  ;;
esac

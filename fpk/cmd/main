#!/bin/bash

FILE_PATH="${TRIM_APPDEST}/docker/docker-compose.yaml"
STATUS_FILE="${TRIM_PKGVAR}/install.status"
LOG_FILE="${TRIM_PKGVAR}/log/install.log"

if [ ! -f "${LOG_FILE}" ] && [ -f "${TRIM_PKGVAR}/install.log" ]; then
  LOG_FILE="${TRIM_PKGVAR}/install.log"
fi

is_docker_running () {
  DOCKER_NAME=""

  if [ -f "$FILE_PATH" ]; then
    DOCKER_NAME=$(cat $FILE_PATH | grep "container_name" | awk -F ':' '{print $2}' | xargs)
  fi

  if [ -n "$DOCKER_NAME" ]; then
    docker inspect $DOCKER_NAME | grep -q "\"Status\": \"running\"," || exit 1
    return
  fi
}

case $1 in
start)
  if [ -f "${STATUS_FILE}" ]; then
    echo "最近安装/升级状态: $(cat "${STATUS_FILE}")"
  fi
  if [ -f "${LOG_FILE}" ]; then
    echo "安装日志: ${LOG_FILE}"
  fi
  exit 0
  ;;
stop)
  exit 0
  ;;
status)
  if is_docker_running; then
    exit 0
  else
    exit 3
  fi
  ;;
*)
  exit 1
  ;;
esac

#!/bin/bash
# 原生进程生命周期

. "$(dirname "$0")/paths.sh"
. "$(dirname "$0")/runtime.sh"
. "$(dirname "$0")/desktop_fix.sh"

PID_FILE="${TRIM_PKGVAR}/lemon-music.pid"
APP_LOG="${TRIM_PKGVAR}/log/app.log"
ENV_FILE="${TRIM_PKGETC}/app.env"

write_app_env() {
  local music downloads config
  load_paths
  if apply_saved_paths 2>/dev/null; then
    music="${RESOLVED_MUSIC}"
    downloads="${RESOLVED_DOWNLOADS}"
    config="$(resolve_config_path)"
  elif resolve_paths 2>/dev/null; then
    music="${RESOLVED_MUSIC}"
    downloads="${RESOLVED_DOWNLOADS}"
    config="$(resolve_config_path)"
  else
    music="${wizard_music_path:-$(default_music_path)}"
    downloads="${wizard_downloads_path:-$(default_downloads_path)}"
    config="$(resolve_config_path 2>/dev/null || default_config_path)"
  fi

  mkdir -p "${music}" "${downloads}" "${config}" "${TRIM_PKGETC}" 2>/dev/null || true
  local listen_port
  listen_port="$(resolve_service_port)"
  cat > "${ENV_FILE}" <<EOF
PORT=${listen_port}
LEMON_NATIVE=1
DOWNLOAD_PATH=${music}
CONFIG_PATH=${config}
MUSIC_HOST_PATH=${music}
DOWNLOADS_HOST_PATH=${downloads}
LOG_PATH=${TRIM_PKGVAR}/log
PKGVAR_PATH=${TRIM_PKGVAR}
EOF
  save_paths "${music}" "${downloads}" "${config}" 2>/dev/null || true
}

load_app_env() {
  if [ -f "${ENV_FILE}" ]; then
    # shellcheck disable=SC1090
    set -a
    . "${ENV_FILE}"
    set +a
  else
    write_app_env
    # shellcheck disable=SC1090
    set -a
    . "${ENV_FILE}"
    set +a
  fi
}

is_pid_running() {
  local pid
  [ -f "${PID_FILE}" ] || return 1
  pid="$(tr -d ' \n\r' < "${PID_FILE}" 2>/dev/null)"
  [ -n "${pid}" ] || return 1
  kill -0 "${pid}" 2>/dev/null
}

is_port_up() {
  local port="${1:-$(read_saved_service_port)}"
  is_tcp_port_in_use "${port}"
}

is_service_running() {
  is_pid_running && return 0
  is_port_up "$(read_saved_service_port)"
}

stop_service() {
  local pid
  if [ -f "${PID_FILE}" ]; then
    pid="$(tr -d ' \n\r' < "${PID_FILE}" 2>/dev/null)"
    if [ -n "${pid}" ]; then
      kill "${pid}" 2>/dev/null || true
      sleep 1
      kill -9 "${pid}" 2>/dev/null || true
    fi
    rm -f "${PID_FILE}" 2>/dev/null || true
  fi
  # 兜底：按端口杀残留
  local port
  port="$(read_saved_service_port)"
  if command -v fuser >/dev/null 2>&1; then
    fuser -k "${port}/tcp" >/dev/null 2>&1 || true
  fi
}

start_service() {
  local root node_bin
  save_accessible_paths 2>/dev/null || true
  write_app_env
  load_app_env

  root="$(app_root)"
  if [ ! -f "${root}/server/index.js" ]; then
    echo "应用文件缺失：${root}/server/index.js。请重新安装 FPK。" > "${TRIM_TEMP_LOGFILE}"
    return 1
  fi

  node_bin="$(resolve_node_bin)" || true
  if [ -z "${node_bin}" ]; then
    prepend_store_node_path || true
    node_bin="$(resolve_node_bin)" || true
  fi
  if [ -z "${node_bin}" ]; then
    echo "未找到 Node.js v22。请在应用中心安装「Node.js v22」（本应用已声明依赖 install_dep_apps=nodejs_v22），然后重试启用。文档路径：/var/apps/nodejs_v22/target/bin" > "${TRIM_TEMP_LOGFILE}"
    return 1
  fi

  if [ ! -d "${root}/node_modules/express" ] || [ ! -d "${root}/node_modules/nodemailer" ]; then
    attach_persist_modules || true
  fi
  if [ ! -d "${root}/node_modules/express" ] || [ ! -d "${root}/node_modules/nodemailer" ]; then
    echo "正在补装依赖（首次启用或依赖有更新，可能需几分钟）…" > "${TRIM_TEMP_LOGFILE}"
    install_node_modules || true
  fi
  if [ ! -d "${root}/node_modules/express" ]; then
    echo "依赖未安装成功。请查看 ${TRIM_PKGVAR}/log/npm-install.log ；确认已安装 Node.js v22，且 NAS 可访问 registry.npmmirror.com。" > "${TRIM_TEMP_LOGFILE}"
    return 1
  fi
  # nodemailer 缺失时仍允许启动（邮件功能按需加载）；下次升级会因 deps.rev 补齐
  if [ ! -d "${root}/node_modules/nodemailer" ]; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] warn: nodemailer 缺失，邮件功能暂不可用，尝试补装…" >> "${APP_LOG}" 2>/dev/null || true
    install_node_modules || true
  fi

  if ! ensure_better_sqlite3_native; then
    echo "better-sqlite3 原生模块不可用。请查看 ${TRIM_PKGVAR}/log/npm-install.log" > "${TRIM_TEMP_LOGFILE}"
    return 1
  fi

  open_service_port "${PORT:-$(read_saved_service_port)}" || true

  if is_service_running; then
    ensure_desktop_entry || true
    return 0
  fi

  mkdir -p "${TRIM_PKGVAR}/log" 2>/dev/null || true
  stop_service
  load_app_env
  local listen_port="${PORT:-$(read_saved_service_port)}"
  if port_blocked_by_others "${listen_port}"; then
    echo "端口 ${listen_port} 已被占用。请到「应用设置」改为 1024–65535 内的空闲端口后再启用。" > "${TRIM_TEMP_LOGFILE}"
    return 1
  fi

  echo "[$(date '+%Y-%m-%d %H:%M:%S')] start root=${root} node=${node_bin}" >> "${APP_LOG}" 2>/dev/null || true

  (
    cd "${root}" || exit 1
    # shellcheck disable=SC1090
    set -a
    [ -f "${ENV_FILE}" ] && . "${ENV_FILE}"
    set +a
    export PORT="${PORT:-$(read_saved_service_port)}"
    export LEMON_NATIVE=1
    export DOWNLOAD_PATH="${DOWNLOAD_PATH}"
    export CONFIG_PATH="${CONFIG_PATH}"
    export MUSIC_HOST_PATH="${MUSIC_HOST_PATH:-$DOWNLOAD_PATH}"
    export DOWNLOADS_HOST_PATH="${DOWNLOADS_HOST_PATH:-$DOWNLOAD_PATH}"
    nohup "${node_bin}" server/index.js >> "${APP_LOG}" 2>&1 &
    echo $! > "${PID_FILE}"
  )

  # 短暂等待端口；协议文件可能略晚于端口就绪，多等几秒再写桌面入口
  local i=0
  local conf_dir
  conf_dir="$(resolve_config_path 2>/dev/null || true)"
  [ -n "${conf_dir}" ] || conf_dir="${CONFIG_PATH:-}"
  while [ "${i}" -lt 20 ]; do
    if is_port_up "${listen_port}"; then
      local j=0
      while [ "${j}" -lt 8 ]; do
        if [ -n "${conf_dir}" ] && [ -f "${conf_dir}/desktop-protocol" ]; then
          break
        fi
        if declare -F probe_local_tls >/dev/null 2>&1 && probe_local_tls "${listen_port}"; then
          break
        fi
        sleep 0.5
        j=$((j + 1))
      done
      ensure_desktop_entry || true
      # 后台再刷一次，覆盖竞态仍写成 http 的情况
      (
        sleep 2
        ensure_desktop_entry || true
      ) >/dev/null 2>&1 &
      return 0
    fi
    # 进程已死：立刻失败并带上日志尾部
    if [ -f "${PID_FILE}" ]; then
      local pid
      pid="$(tr -d ' \n\r' < "${PID_FILE}" 2>/dev/null)"
      if [ -n "${pid}" ] && ! kill -0 "${pid}" 2>/dev/null; then
        tip="进程启动后退出。请查看日志 ${APP_LOG}"
        if [ -f "${APP_LOG}" ]; then
          tip="${tip} | $(tail -n 8 "${APP_LOG}" 2>/dev/null | tr '\n' ' ')"
        fi
        echo "${tip}" > "${TRIM_TEMP_LOGFILE}"
        return 1
      fi
    fi
    sleep 1
    i=$((i + 1))
  done

  tip="端口 ${listen_port} 未就绪。请 SSH 查看：tail -n 50 ${APP_LOG}"
  if [ -f "${APP_LOG}" ]; then
    tip="${tip} | $(tail -n 5 "${APP_LOG}" 2>/dev/null | tr '\n' ' ')"
  fi
  echo "${tip}" > "${TRIM_TEMP_LOGFILE}"
  return 1
}

case $1 in
start)
  if start_service; then
    exit 0
  fi
  exit 1
  ;;
stop)
  stop_service
  exit 0
  ;;
status)
  if is_service_running; then
    exit 0
  fi
  exit 3
  ;;
*)
  exit 1
  ;;
esac

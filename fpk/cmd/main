#!/bin/bash

. "$(dirname "$0")/paths.sh"

is_docker_running() {
  docker inspect -f '{{.State.Running}}' "${CONTAINER_NAME}" 2>/dev/null | grep -qi true
}

ensure_containers_created() {
  cd "${COMPOSE_DIR}" || return 1

  # 若用户已在运行设置里配过路径，确保挂载真正生效
  if paths_ready || resolve_paths; then
    ensure_mounts_applied || true
  fi

  if is_docker_running; then
    return 0
  fi

  if [ -f "${COMPOSE_ENV}" ]; then
    if compose_up "${COMPOSE_PROJECT}" 2>&1 || compose_up "lemon-music" 2>&1; then
      return 0
    fi
  fi

  echo "Docker 容器启动失败。请检查 7983 端口、容器名冲突，或到运行设置重新保存数据目录。" > "${TRIM_TEMP_LOGFILE}"
  return 1
}

case $1 in
start)
  if paths_ready || resolve_paths; then
    ensure_mounts_applied || true
  fi
  exit 0
  ;;
stop)
  exit 0
  ;;
status)
  if ! ensure_containers_created; then
    exit 1
  fi
  if is_docker_running; then
    exit 0
  fi
  exit 3
  ;;
*)
  exit 1
  ;;
esac

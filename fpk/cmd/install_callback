#!/bin/bash
# 55% 起：写 compose → 脚本 docker pull（stdout 可见）→ 等待飞牛 docker-project 拉取完成。
# 早期顺畅版依赖 resource.json 的 docker-project，进度条会 55→56→58→65 递增。

. "$(dirname "$0")/pull-image.sh"
. "$(dirname "$0")/paths.sh"
. "$(dirname "$0")/desktop_fix.sh"

init_log

echo "callback started $(date -Iseconds)" > "${TRIM_PKGVAR}/install.status" 2>/dev/null || true
update_install_ui "安装脚本已启动，正在写入 compose…"

music_path="${wizard_music_path:-}"
downloads_path="${wizard_downloads_path:-}"
config_path="$(default_config_path)"

if [ -z "${music_path}" ]; then
  music_path="$(default_music_path)"
fi
if [ -z "${downloads_path}" ]; then
  downloads_path="$(default_downloads_path)"
fi

mkdir -p "${config_path}" "${music_path}" "${downloads_path}" 2>/dev/null || true
save_paths "${music_path}" "${downloads_path}" "${config_path}"
write_mounts_meta "${music_path}" "${downloads_path}" "${config_path}"
resolve_image_from_wizard
write_compose_file "${music_path}" "${downloads_path}" "${config_path}"
update_compose_image 2>/dev/null || true

case "${music_path}" in
  "${TRIM_PKGVAR}"/*) ;;
  *)
    touch "${config_path}/.user-paths-configured" 2>/dev/null || true
    ;;
esac

log_config "install paths music=${music_path} downloads=${downloads_path} config=${config_path}"

init_docker_access 2>/dev/null || true
docker_cmd stop "${CONTAINER_NAME}" >/dev/null 2>&1 || true
docker_cmd rm -f "${CONTAINER_NAME}" >/dev/null 2>&1 || true
docker_cmd compose -p "${COMPOSE_PROJECT}" -f "${COMPOSE_FILE}" down --remove-orphans >/dev/null 2>&1 || true
docker_cmd compose -p "lemon-music" -f "${COMPOSE_FILE}" down --remove-orphans >/dev/null 2>&1 || true

_pull_timeout="$(get_pull_timeout)"

if [ "${wizard_pull_source:-mirror_1ms}" = "skip_pull" ]; then
  SOFT_PULL_FAIL=1
  if ! pull_image_with_progress "安装"; then
    fail_install "本地不存在镜像。请先 SSH pull 并 docker tag … lemon-music:latest"
  fi
else
  update_install_ui "【开始拉取】目标：${IMAGE}
请观察进度条 55→65 与下方说明（约 500MB）"

  SOFT_PULL_FAIL=1
  if pull_image_with_progress "安装"; then
    log_config "install script pull ok image=${IMAGE}"
  else
    log_line "脚本 pull 暂未成功，继续等待飞牛 docker-project 拉取…"
  fi

  if ! wait_for_local_image "${_pull_timeout}"; then
    fail_install "等待镜像超时（${_pull_timeout}s）。请检查网络，或 SSH pull 后选手动安装并选「跳过拉取」。"
  fi

  normalize_pulled_image || true
fi

if resolved="$(resolve_local_image_name "$(get_compose_image)" 2>/dev/null)"; then
  IMAGE="${resolved}"
elif listed="$(any_lemon_image_in_docker_list 2>/dev/null)"; then
  IMAGE="${listed}"
  normalize_pulled_image || true
fi

if [ -n "${IMAGE:-}" ]; then
  mkdir -p "${TRIM_PKGETC}" 2>/dev/null || true
  cat > "${IMAGE_CONF}" <<EOF
SAVED_IMAGE="${LOCAL_IMAGE_ALIAS}"
REMOTE_IMAGE="${IMAGE}"
SAVED_AT="$(date -Iseconds)"
EOF
  write_compose_file "${music_path}" "${downloads_path}" "${config_path}"
  update_compose_image
  log_config "install using image ${IMAGE}"
fi

mark_install_complete "安装"
ensure_desktop_entry || true

# 不在 install 阶段 docker run：避免与 docker-project 争抢导致 80% 假死；启用时 main 会按目录重建容器
if any_lemon_image_in_docker_list >/dev/null 2>&1 \
  || resolve_local_image_name "$(get_compose_image)" >/dev/null 2>&1; then
  log_line "镜像已在本地，安装完成；请在本应用点击「启用」启动容器"
  update_install_ui "【安装完成】镜像已就绪（Docker 本地镜像中可见）。
请点击应用中心「启用」启动容器并访问 http://<NAS_IP>:7983"
else
  log_line "安装完成但暂未检测到镜像名，启用时将自动拉取"
  update_install_ui "【安装完成】请点击「启用」；若无镜像将自动拉取"
fi

exit 0

#!/bin/bash
# 原生安装：准备目录 → 等待商店 Node.js v22（install_dep_apps）→ npm 安装业务依赖 → 交由「启用」启动

. "$(dirname "$0")/paths.sh"
. "$(dirname "$0")/runtime.sh"
. "$(dirname "$0")/desktop_fix.sh"
. "$(dirname "$0")/app-data.sh"

init_log() {
  mkdir -p "${TRIM_PKGVAR}/log" 2>/dev/null || true
}

log_line() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "${TRIM_PKGVAR}/log/install.log" 2>/dev/null || true
}

update_install_ui() {
  if [ -n "${TRIM_TEMP_LOGFILE:-}" ]; then
    echo "$1" > "${TRIM_TEMP_LOGFILE}" 2>/dev/null || true
  fi
}

fail_install() {
  update_install_ui "$1"
  log_line "FAIL: $1"
  exit 1
}

mark_install_complete() {
  echo "install complete $(date -Iseconds)" > "${TRIM_PKGVAR}/install.status" 2>/dev/null || true
  log_line "安装完成"
}

init_log
echo "callback started $(date -Iseconds)" > "${TRIM_PKGVAR}/install.status" 2>/dev/null || true
update_install_ui "安装脚本已启动…"

restore_app_data >/dev/null 2>&1 || true
load_paths

music_path="${wizard_music_path:-}"
downloads_path="${wizard_downloads_path:-}"
config_path="$(default_config_path)"
if declare -F resolve_config_path >/dev/null 2>&1; then
  config_path="$(resolve_config_path)"
fi

if [ -z "${music_path}" ]; then
  music_path="$(default_music_path)"
fi
if [ -z "${downloads_path}" ]; then
  downloads_path="$(default_downloads_path)"
fi

mkdir -p "${config_path}" "${music_path}" "${downloads_path}" 2>/dev/null || true
save_paths "${music_path}" "${downloads_path}" "${config_path}"

# 写入运行环境
mkdir -p "${TRIM_PKGETC}" 2>/dev/null || true
cat > "${TRIM_PKGETC}/app.env" <<EOF
PORT=7983
LEMON_NATIVE=1
DOWNLOAD_PATH=${music_path}
CONFIG_PATH=${config_path}
MUSIC_HOST_PATH=${music_path}
DOWNLOADS_HOST_PATH=${downloads_path}
EOF

case "${music_path}" in
  "${TRIM_PKGVAR}"/*) ;;
  *)
    touch "${config_path}/.user-paths-configured" 2>/dev/null || true
    ;;
esac

log_line "paths music=${music_path} downloads=${downloads_path} config=${config_path}"

# 确保 FPK 内业务代码就位（构建脚本应拷到 TRIM_APPDEST）
APP_ROOT="$(app_root)"
if [ ! -f "${APP_ROOT}/server/index.js" ]; then
  fail_install "安装包缺少应用代码（server/index.js）。请使用完整构建的 FPK。"
fi
if [ ! -f "${APP_ROOT}/package.json" ]; then
  fail_install "安装包缺少 package.json。请重新用 scripts/build-fpk.ps1 打包。"
fi

# —— 商店 Node：文档路径 + install_dep_apps；禁止对已装包再 install ——
update_install_ui "检查商店依赖 Node.js v22…"
log_line "gate: wait_for_store_dependencies begin"
prepend_store_node_path || true
if ! wait_for_store_dependencies; then
  if is_store_node_ready || store_nodejs_dir_present; then
    log_line "gate: wait 超时但 node/目录可用，继续安装"
  else
    fail_install "未检测到商店依赖 Node.js v22。请在应用中心安装「Node.js v22」后重新安装本应用（已声明 install_dep_apps=nodejs_v22）。"
  fi
fi
log_line "gate: wait_for_store_dependencies ok，继续本应用安装"

# 若 FPK 已内置 node_modules，则跳过联网 npm（并迁入数据目录，便于下次升级复用）
if [ -d "${APP_ROOT}/node_modules/express" ]; then
  update_install_ui "商店依赖已就绪；检测到内置依赖，跳过 npm…"
  log_line "bundled node_modules present, skip npm"
  attach_persist_modules || true
  echo "$(deps_fingerprint "${APP_ROOT}")" > "${TRIM_PKGVAR}/npm.deps.stamp" 2>/dev/null || true
else
  update_install_ui "商店依赖已就绪；正在安装本应用 npm 依赖… 进度可能停在 55% 附近几分钟，请勿取消"
  if ! install_node_modules; then
    fail_install "本应用 npm 依赖安装失败（商店 Node 已就绪）。请查看 ${TRIM_PKGVAR}/log/npm-install.log；确认可访问 registry.npmmirror.com"
  fi
fi

update_install_ui "检查 better-sqlite3 原生模块…"
if ! ensure_better_sqlite3_native; then
  fail_install "better-sqlite3 原生库缺失。请确认商店 Node.js v22 可用，并查看 ${TRIM_PKGVAR}/log/npm-install.log"
fi

ensure_desktop_entry || true
mark_install_complete
update_install_ui "【安装完成】请点「启用」。若一直「启用中」，SSH：tail -n 80 ${TRIM_PKGVAR}/log/app.log"
exit 0

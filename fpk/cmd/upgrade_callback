#!/bin/bash
# 升级：保留数据目录；更新代码后按需重装依赖（可写 npm 缓存，避免卡在 55%）

. "$(dirname "$0")/paths.sh"
. "$(dirname "$0")/runtime.sh"
. "$(dirname "$0")/desktop_fix.sh"

init_log() { mkdir -p "${TRIM_PKGVAR}/log" 2>/dev/null || true; }
log_line() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "${TRIM_PKGVAR}/log/install.log" 2>/dev/null || true; }
update_install_ui() { [ -n "${TRIM_TEMP_LOGFILE:-}" ] && echo "$1" > "${TRIM_TEMP_LOGFILE}" 2>/dev/null || true; }
fail_install() { update_install_ui "$1"; log_line "FAIL: $1"; exit 1; }

init_log
log_line "升级回调开始（原生）"
update_install_ui "升级中：停止旧进程…"

PID_FILE="${TRIM_PKGVAR}/lemon-music.pid"
if [ -f "${PID_FILE}" ]; then
  kill "$(tr -d ' \n\r' < "${PID_FILE}" 2>/dev/null)" 2>/dev/null || true
  rm -f "${PID_FILE}" 2>/dev/null || true
fi
if command -v fuser >/dev/null 2>&1; then
  fuser -k 7983/tcp >/dev/null 2>&1 || true
fi

load_paths

APP_ROOT="$(app_root)"
if [ ! -f "${APP_ROOT}/server/index.js" ]; then
  fail_install "升级包缺少 server/index.js"
fi

update_install_ui "检查 Node.js v22…"
ensure_store_node || fail_install "未找到 Node.js v22，请先在应用中心安装该依赖后重试升级。"

update_install_ui "安装依赖（国内源，请耐心等待）…"
# force：依赖清单可能变更；缓存写入应用目录，避免 /home 无权限导致卡死
install_node_modules force || fail_install "npm 依赖安装失败：${TRIM_PKGVAR}/log/npm-install.log"

update_install_ui "检查 better-sqlite3…"
ensure_better_sqlite3_native || fail_install "better-sqlite3 原生模块不可用：${TRIM_PKGVAR}/log/npm-install.log"

ensure_desktop_entry || true
update_install_ui "【升级完成】请点「启用」。若一直启用中，SSH 查看：tail -n 80 ${TRIM_PKGVAR}/log/app.log"
log_line "升级完成"
exit 0

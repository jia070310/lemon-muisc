#!/bin/bash

. "$(dirname "$0")/pull-image.sh"
. "$(dirname "$0")/paths.sh"
. "$(dirname "$0")/desktop_fix.sh"

init_log

log_line "=========================================="
log_line "柠檬音乐下载 · 升级回调"
log_line "=========================================="

if apply_saved_paths; then
  log_line "已恢复路径: music=${RESOLVED_MUSIC} downloads=${RESOLVED_DOWNLOADS}"
elif resolve_paths; then
  config="$(resolve_config_path)"
  write_compose_file "${RESOLVED_MUSIC}" "${RESOLVED_DOWNLOADS}" "${config}"
  log_line "已从访问权限/向导恢复路径"
else
  load_paths
  if paths_ready; then
    config="$(resolve_config_path)"
    write_compose_file "${wizard_music_path}" "${wizard_downloads_path}" "${config}"
    log_line "已从 paths.conf 恢复路径"
  else
    log_line "警告: 未找到完整路径配置，升级后请检查访问权限"
  fi
fi

docker stop "${CONTAINER_NAME}" >/dev/null 2>&1 || true
docker rm -f "${CONTAINER_NAME}" >/dev/null 2>&1 || true

update_install_ui "正在拉取 Docker 镜像，请耐心等待…"

if [ "${wizard_pull_source:-ghcr_direct}" = "skip_pull" ]; then
  SOFT_PULL_FAIL=1
  pull_image_with_progress "升级" || true
else
  unset SOFT_PULL_FAIL
  if ! pull_image_with_progress "升级"; then
    fail_install "升级时镜像拉取失败。请检查网络或 SSH 手动 pull 后选「跳过拉取」。"
  fi
fi

if resolved="$(resolve_local_image_name "$(get_compose_image)" 2>/dev/null)"; then
  IMAGE="${resolved}"
  mkdir -p "${TRIM_PKGETC}" 2>/dev/null || true
  cat > "${IMAGE_CONF}" <<EOF
SAVED_IMAGE="${LOCAL_IMAGE_ALIAS}"
REMOTE_IMAGE="${resolved}"
SAVED_PULL_SOURCE="${wizard_pull_source:-ghcr_direct}"
SAVED_AT="$(date -Iseconds)"
EOF
  if paths_ready || resolve_paths; then
    music="${RESOLVED_MUSIC:-${wizard_music_path}}"
    downloads="${RESOLVED_DOWNLOADS:-${wizard_downloads_path}}"
    config="$(resolve_config_path)"
    write_compose_file "${music}" "${downloads}" "${config}"
    log_line "已写入 compose 镜像: ${IMAGE}"
  fi
fi

update_install_ui "镜像已就绪，正在重建容器…"
export SKIP_REMOTE_PULL=1

if resolve_local_image_name "$(get_compose_image)" >/dev/null 2>&1; then
  if recreate_compose_stack; then
    log_line "升级后容器已重建"
    update_install_ui "升级完成"
  else
    log_line "容器暂未启动，请在应用中心停用再启用"
    update_install_ui "镜像已拉取完成，请停用再启用应用"
  fi
else
  fail_install "升级完成但未检测到本地镜像。"
fi

ensure_desktop_entry || true
mark_install_complete "升级"
exit 0

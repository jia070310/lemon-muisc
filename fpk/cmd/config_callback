#!/bin/bash

. "$(dirname "$0")/paths.sh"

log_config "config_callback start music=${wizard_music_path:-} downloads=${wizard_downloads_path:-} accessible=${TRIM_DATA_ACCESSIBLE_PATHS:-}"

# 访问权限变更时飞牛会走 config 流程并带上 TRIM_DATA_ACCESSIBLE_PATHS
save_accessible_paths

if ! apply_saved_paths; then
  echo "请在「访问权限」添加音乐库与下载文件夹，或在「运行设置」填写绝对路径。" > "${TRIM_TEMP_LOGFILE}"
  log_config "config_callback paths incomplete"
  exit 1
fi

if ! recreate_compose_stack; then
  echo "路径已保存，但容器重建失败。请停用再启用应用。日志：${TRIM_PKGVAR}/log/compose.recreate.log" > "${TRIM_TEMP_LOGFILE}"
  log_config "config_callback recreate failed"
fi

exit 0

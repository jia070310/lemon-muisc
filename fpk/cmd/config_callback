#!/bin/bash

. "$(dirname "$0")/paths.sh"

log_config "config_callback start env_music=${wizard_music_path:-} env_downloads=${wizard_downloads_path:-} accessible=${TRIM_DATA_ACCESSIBLE_PATHS:-}"

if apply_saved_paths; then
  if recreate_compose_stack; then
    log_config "config_callback recreate ok"
  else
    log_config "config_callback recreate failed — will retry on app status/start"
  fi
else
  log_config "config_callback paths incomplete"
fi

exit 0

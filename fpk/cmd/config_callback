#!/bin/bash

. "$(dirname "$0")/paths.sh"
. "$(dirname "$0")/runtime.sh"
. "$(dirname "$0")/desktop_fix.sh"

log_config "config_callback start music=${wizard_music_path:-} downloads=${wizard_downloads_path:-} accessible=${TRIM_DATA_ACCESSIBLE_PATHS:-}"

save_accessible_paths

if ! apply_saved_paths; then
  echo "请在「访问权限」添加音乐库与下载文件夹，或在「运行设置」填写绝对路径。" > "${TRIM_TEMP_LOGFILE}"
  log_config "config_callback paths incomplete"
  exit 1
fi

music="${RESOLVED_MUSIC}"
downloads="${RESOLVED_DOWNLOADS}"
config="$(resolve_config_path)"
listen_port="$(read_saved_service_port)"
if [ -n "${wizard_port:-}" ]; then
  listen_port="$(echo "${wizard_port}" | tr -d ' \r')"
  require_service_port_available "${listen_port}" || exit 1
fi
mkdir -p "${music}" "${downloads}" "${config}" "${TRIM_PKGETC}" 2>/dev/null || true
cat > "${TRIM_PKGETC}/app.env" <<EOF
PORT=${listen_port}
LEMON_NATIVE=1
DOWNLOAD_PATH=${music}
CONFIG_PATH=${config}
MUSIC_HOST_PATH=${music}
DOWNLOADS_HOST_PATH=${downloads}
EOF
save_paths "${music}" "${downloads}" "${config}"
ensure_desktop_entry || true
log_config "config_callback saved env music=${music} port=${listen_port}"

# 若正在运行则提示用户停用再启用（避免配置回调里杀进程导致飞牛状态错乱）
echo "已保存。请停用后再启用，使目录 / 端口生效。" > "${TRIM_TEMP_LOGFILE}"
exit 0

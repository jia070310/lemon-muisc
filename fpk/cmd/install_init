#!/bin/bash
# 飞牛在解压前调用 install_init；必须秒退，不能 pull / cleanup，否则会卡在 40%。

. "$(dirname "$0")/pull-image.sh"

init_log
resolve_image_from_wizard

if command -v docker >/dev/null 2>&1; then
  log_line "install_init 通过（拉取在 install_callback 进行） image=${IMAGE} source=${wizard_pull_source:-ghcr_direct}"
else
  log_line "install_init 通过（未检测到 docker 命令，将在 install_callback 检查） image=${IMAGE}"
fi
exit 0
